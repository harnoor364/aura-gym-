---
import Photo from "./Photo.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site";
---
<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <div class="hero-media">
    <Photo slot="hero" priority sizes="100vw" number="01" />
  </div>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="wrap hero-body">
    <p class="hero-place label">
      <Icon name="pin" />
      <span>{site.branch} · {site.city}, Punjab</span>
    </p>

    <h1 class="hero-title display" id="hero-title">
      <span class="line">Built by discipline.</span>
      <span class="line">Defined by <em class="accent">you.</em></span>
    </h1>

    <div class="hero-foot">
      <p class="hero-copy">
        A focused training floor on Lodhi Club Road, BRS Nagar. Explore the gym, find the way you want to train, and take the next step when you are ready.
      </p>
      <div class="hero-actions">
        <a class="btn" href="#contact">Enquire now <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href="#facilities">Explore the gym</a>
      </div>
    </div>
  </div>

  <div class="hero-bar">
    <div class="wrap hero-bar-inner">
      <span class="label muted hero-bar-addr">Lodhi Club Road · New BRS Nagar</span>
      <a class="label hero-bar-phone" href={`tel:${site.phone.tel}`}><Icon name="phone" /> {site.phone.display}</a>
      <a class="label hero-scroll" href="#club" aria-label="Scroll to the next section">
        <span>Scroll</span><span class="hero-scroll-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: max(640px, 100svh); max-height: 1100px;
    display: grid; grid-template-rows: 1fr auto;
    background: var(--ink);
  }
  .hero-media { position: absolute; inset: 0; z-index: -2; }
  .hero-media :global(.photo) { animation: hero-in 2.4s var(--ease) both; }
  .hero-media :global(.ph-motif) { width: min(80%, 1000px); height: 64%; bottom: 16%; left: 64%; opacity: 0.12; }
  .hero-media :global(.ph-label) { left: auto; right: var(--gutter); top: calc(var(--header-h) + 1.25rem); text-align: right; justify-items: end; }
  @keyframes hero-in { from { transform: scale(1.06); opacity: 0.4; } to { transform: none; opacity: 1; } }

  .hero-shade {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      linear-gradient(90deg, rgb(13 13 12 / 0.88) 0%, rgb(13 13 12 / 0.55) 42%, rgb(13 13 12 / 0.1) 75%),
      linear-gradient(0deg, rgb(13 13 12 / 0.95) 0%, rgb(13 13 12 / 0) 38%),
      linear-gradient(180deg, rgb(13 13 12 / 0.6) 0%, rgb(13 13 12 / 0) 22%);
  }

  .hero-body {
    align-self: end; display: grid; gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: calc(var(--header-h) + 4rem); padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .hero-place { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--bone); }
  .hero-place :global(svg) { width: 1rem; height: 1rem; color: var(--ember); }

  .hero-title { font-size: var(--t-hero); }
  @media (min-width: 1000px) { .hero-title .line { white-space: nowrap; } }
  .hero-title .line { display: block; }
  .hero-title em { font-style: normal; }
  .js .hero-title .line { animation: rise 1s var(--ease) both; }
  .js .hero-title .line + .line { animation-delay: 0.12s; }
  @keyframes rise { from { opacity: 0; transform: translateY(0.35em); } to { opacity: 1; transform: none; } }

  .hero-foot { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--s-6); }
  .hero-copy { max-width: 44ch; font-size: var(--t-lg); line-height: 1.5; color: #ddd7cd; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }

  .hero-bar { border-top: 1px solid var(--line); background: rgb(13 13 12 / 0.7); }
  .hero-bar-inner { min-height: 64px; display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: var(--s-6); }
  .hero-bar-phone { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--bone); }
  .hero-bar-phone :global(svg) { width: 1rem; height: 1rem; color: var(--ember); }
  .hero-bar-phone:hover { color: var(--ember); }
  .hero-scroll { display: inline-flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--ash); }
  .hero-scroll-line { position: relative; width: 1px; height: 28px; background: var(--line); overflow: hidden; }
  .hero-scroll-line::after {
    content: ""; position: absolute; left: 0; top: -40%; width: 1px; height: 40%; background: var(--ember);
    animation: drop 2.2s var(--ease) infinite;
  }
  @keyframes drop { to { top: 100%; } }

  @media (max-width: 720px) {
    .hero { min-height: max(600px, 100svh); }
    .hero-media :global(.ph-motif) { left: 50%; width: 130%; height: 40%; bottom: 46%; }
    .hero-media :global(.ph-label) { display: none; }
    .hero-shade {
      background:
        linear-gradient(0deg, rgb(13 13 12 / 0.96) 0%, rgb(13 13 12 / 0.75) 45%, rgb(13 13 12 / 0.2) 75%),
        linear-gradient(180deg, rgb(13 13 12 / 0.6) 0%, rgb(13 13 12 / 0) 22%);
    }
    .hero-actions { width: 100%; }
    .hero-actions .btn { flex: 1 1 auto; }
    .hero-bar-inner { grid-template-columns: 1fr auto; }
    .hero-bar-addr { display: none; }
  }
</style>
