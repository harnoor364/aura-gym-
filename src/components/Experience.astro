---
import Photo from "./Photo.astro";
---
<section class="experience" id="experience" aria-labelledby="exp-title">
  <div class="exp-band">
    <div class="exp-media"><Photo slot="experience" sizes="100vw" number="09" /></div>
    <div class="exp-shade" aria-hidden="true"></div>
    <div class="wrap exp-band-copy">
      <p class="index-label label" data-reveal><b>04</b> The experience</p>
      <h2 class="display exp-title" id="exp-title" data-reveal>Show up.<br />Do the work.<br /><span class="accent">Repeat.</span></h2>
    </div>
  </div>

  <div class="wrap exp-steps-wrap">
    <div class="grid exp-intro">
      <h3 class="h3" data-reveal>Your first steps at BRS Nagar</h3>
      <p class="muted" data-reveal>No pressure and no sales script — just a straightforward way to find out whether this is your gym.</p>
    </div>
    <ol class="exp-steps" role="list">
      <li class="exp-step" data-reveal>
        <span class="exp-step-n display">01</span>
        <h4>Call or drop in</h4>
        <p class="muted">Ask the front desk about membership options, timings and anything specific you want to work on.</p>
      </li>
      <li class="exp-step" data-reveal>
        <span class="exp-step-n display">02</span>
        <h4>Look around</h4>
        <p class="muted">See the training floor for yourself and picture how your sessions would run.</p>
      </li>
      <li class="exp-step" data-reveal>
        <span class="exp-step-n display">03</span>
        <h4>Start training</h4>
        <p class="muted">Join when it feels right, settle into a routine and make the floor yours.</p>
      </li>
    </ol>
  </div>
</section>

<style>
  .experience { background: var(--ink); padding-bottom: var(--section); }
  .exp-band { position: relative; isolation: isolate; min-height: clamp(520px, 92svh, 980px); display: grid; align-items: end; overflow: hidden; }
  .exp-media { position: absolute; inset: -10% 0; z-index: -2; }
  .exp-media :global(.ph-motif) { width: min(60%, 820px); height: 58%; bottom: 24%; left: 68%; opacity: 0.14; }
  .exp-media :global(.ph-label) { left: auto; right: var(--gutter); top: 14%; text-align: right; justify-items: end; }
  .exp-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, var(--ink) 0%, rgb(13 13 12 / 0.55) 40%, rgb(13 13 12 / 0.2) 100%); }
  .exp-band-copy { display: grid; gap: var(--s-6); padding-bottom: clamp(3rem, 7vw, 6rem); }
  .exp-title { font-size: var(--t-hero); }

  /* Subtle parallax, CSS-only, where scroll-driven animations are supported */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .exp-media { animation: drift linear both; animation-timeline: view(); animation-range: cover; }
      @keyframes drift { from { transform: translateY(-6%); } to { transform: translateY(6%); } }
    }
  }

  .exp-steps-wrap { padding-top: clamp(3rem, 6vw, 5rem); }
  .exp-intro { row-gap: var(--s-4); margin-bottom: clamp(2.5rem, 5vw, 4rem); align-items: end; }
  .exp-intro h3 { grid-column: 1 / span 5; }
  .exp-intro p { grid-column: 7 / span 5; max-width: 46ch; }
  .exp-steps { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .exp-step { display: grid; gap: var(--s-4); align-content: start; padding: var(--s-6) clamp(1rem, 3vw, 2.5rem) 0 0; }
  .exp-step + .exp-step { border-left: 1px solid var(--line); padding-left: clamp(1rem, 3vw, 2.5rem); }
  .exp-step-n { font-size: var(--t-2xl); color: var(--ember); line-height: 1; }
  .exp-step h4 { font-size: var(--t-xl); font-weight: 700; letter-spacing: -0.01em; }

  @media (max-width: 860px) {
    .exp-intro h3, .exp-intro p { grid-column: 1 / -1; }
    .exp-steps { grid-template-columns: 1fr; }
    .exp-step, .exp-step + .exp-step { border-left: 0; padding: var(--s-6) 0; border-bottom: 1px solid var(--line); grid-template-columns: 5rem 1fr; column-gap: var(--s-5); }
    .exp-step-n { grid-row: 1 / span 2; }
  }
</style>
